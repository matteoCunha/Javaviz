<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="30" style="-fx-background-color: #121212; -fx-padding: 30;"
      stylesheets="@styles.css"
      xmlns:fx="http://javafx.com/fxml" fx:controller="controller.AdvancedStatsController">

    <Label text="📈 Statistiques Évoluées" style="-fx-text-fill: white; -fx-font-size: 28; -fx-font-weight: bold;"/>

    <HBox spacing="30" VBox.vgrow="ALWAYS">

        <VBox VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS" style="-fx-background-color: #181818; -fx-padding: 20; -fx-background-radius: 10;">
            <Label text="Top 5 - Morceaux les plus écoutés" style="-fx-text-fill: #b3b3b3; -fx-font-size: 16;"/>
            <BarChart fx:id="morceauxChart" VBox.vgrow="ALWAYS" legendVisible="false">
                <xAxis>
                    <CategoryAxis tickLabelFill="white"/>
                </xAxis>
                <yAxis>
                    <NumberAxis tickLabelFill="white"/>
                </yAxis>
            </BarChart>
        </VBox>

        <VBox VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS" style="-fx-background-color: #181818; -fx-padding: 20; -fx-background-radius: 10;">
            <Label text="Top 5 - Artistes les plus écoutés" style="-fx-text-fill: #b3b3b3; -fx-font-size: 16;"/>
            <PieChart fx:id="artistesChart" VBox.vgrow="ALWAYS" legendVisible="true" style="-fx-text-fill: white;"/>
        </VBox>
    </HBox>
    <VBox spacing="15" style="-fx-background-color: #181818; -fx-padding: 25; -fx-background-radius: 10;">
        <Label text="🔍 Consulter les écoutes par élément" style="-fx-text-fill: #b3b3b3; -fx-font-size: 18; -fx-font-weight: bold;"/>

        <GridPane hgap="30" vgap="15">
            <Label text="Morceau :" style="-fx-text-fill: white;" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <ComboBox fx:id="comboMorceau" prefWidth="250" promptText="Choisir un morceau..." GridPane.columnIndex="1" GridPane.rowIndex="0"/>
            <Label fx:id="resMorceau" text="0 écoutes" style="-fx-text-fill: #1db954; -fx-font-weight: bold;" GridPane.columnIndex="2" GridPane.rowIndex="0"/>

            <Label text="Album :" style="-fx-text-fill: white;" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <ComboBox fx:id="comboAlbum" prefWidth="250" promptText="Choisir un album..." GridPane.columnIndex="1" GridPane.rowIndex="1"/>
            <Label fx:id="resAlbum" text="0 écoutes" style="-fx-text-fill: #1db954; -fx-font-weight: bold;" GridPane.columnIndex="2" GridPane.rowIndex="1"/>

            <Label text="Artiste :" style="-fx-text-fill: white;" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <ComboBox fx:id="comboArtiste" prefWidth="250" promptText="Choisir un artiste..." GridPane.columnIndex="1" GridPane.rowIndex="2"/>
            <Label fx:id="resArtiste" text="0 écoutes" style="-fx-text-fill: #1db954; -fx-font-weight: bold;" GridPane.columnIndex="2" GridPane.rowIndex="2"/>

            <Label text="Groupe :" style="-fx-text-fill: white;" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
            <ComboBox fx:id="comboGroupe" prefWidth="250" promptText="Choisir un groupe..." GridPane.columnIndex="1" GridPane.rowIndex="3"/>
            <Label fx:id="resGroupe" text="0 écoutes" style="-fx-text-fill: #1db954; -fx-font-weight: bold;" GridPane.columnIndex="2" GridPane.rowIndex="3"/>
        </GridPane>
    </VBox>
</VBox>